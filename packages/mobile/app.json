{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.songremote_r7f2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://release-hwih5dc-preview-4200.runable.site/",
      "applicationId": "release-hwih5dc",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.songremote_r7f2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "name": "Finish the Song Remote",
    "slug": "finish-the-song-remote",
    "version": "1.0.0",
    "scheme": "runable-release-hwih5dc",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Record vocal takes to transfer to your Ableton session."
        }
      ],
      "expo-font"
    ]
  }
}